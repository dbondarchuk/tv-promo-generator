# Process / infrastructure only. App settings live in config/settings.json (UI).
# On first start, settings.json is created from defaults (and any legacy app env
# keys below are copied in once if still present).

# HTTP
PORT=5174
# debug | info | warn | error
LOG_LEVEL=info

# Paths for this process
CACHE_PATH=./cache
CONFIG_PATH=./config

# Optional absolute binaries (otherwise: tools/ffmpeg from `npm run setup:ffmpeg`, then PATH)
# FFMPEG_PATH=
# FFPROBE_PATH=

# Display timezone fallback when Settings → timezone is empty
# TIME_ZONE=America/New_York
