# Copy to .env and adjust. Values here override settings.json when set.

# HTTP
PORT=5174
# debug | info | warn | error
LOG_LEVEL=info

# ErsatzTV
ETV_URL=http://localhost:8409
ETV_API_KEY=
ETV_DATABASE=./etv-config/ersatztv.sqlite3

# Media paths
# LIBRARY_PATH = where this app can read media files
# ETV_PATH_PREFIX = path prefix as stored in ersatztv.sqlite3 (rewritten to LIBRARY_PATH)
# Example: DB has /media/videos/shows/... and host has Y:\videos\shows\...
#   LIBRARY_PATH=Y:\videos
#   ETV_PATH_PREFIX=/media/videos
LIBRARY_PATH=./media
ETV_PATH_PREFIX=/media/videos
OUTPUT_PATH=./output
# Path to the promo folder as ErsatzTV sees it (same folder as OUTPUT_PATH, different mount)
ETV_LIBRARY_PATH=./output

CACHE_PATH=./cache
CONFIG_PATH=./config

# Optional absolute paths (otherwise: tools/ffmpeg from `npm run setup:ffmpeg`, then PATH)
# FFMPEG_PATH=
# FFPROBE_PATH=

# Encoding (None | Nvenc | Qsv | Vaapi | Amf | VideoToolbox)
HARDWARE_ACCELERATION=None
VAAPI_DEVICE=/dev/dri/renderD128
VAAPI_DRIVER=Default
VAAPI_DISPLAY=drm
VIDEO_CODEC=H264
VIDEO_BITRATE=4000
AUDIO_BITRATE=192
RESOLUTION=1920x1080
VIDEO_PRESET=medium
VIDEO_PROFILE=high

# Voice-over and regen
VOICE_ENABLED=true
# Piper (Wyoming TCP) preferred; falls back to Edge TTS then Windows SAPI.
TTS_TIMEOUT_MS=20000
# Silence between "Next on {channel}." and the title (ms)
VOICE_PAUSE_MS=450
PIPER_URL=http://192.168.0.151:10200
# Per-language Piper voices; otherwise auto-picked from describe()
PIPER_VOICE_EN=en_GB-alba-medium
PIPER_VOICE_UK=uk_UA-lada-x_low
# PIPER_VOICE=          # default fallback for other languages
# PIPER_SPEAKER=
REGEN_LEAD_MINUTES=3
